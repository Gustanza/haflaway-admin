                          SizedBox(width: 6),
                          Text(
                            "All Cards",
                            style: TextStyle(
                              fontSize: 14,
                              fontWeight: _selectedKardFilter == null ? FontWeight.w600 : FontWeight.w500,
                              color: _selectedKardFilter == null ? primaryColor : Colors.black54,
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                ),
              ),
              // Individual card filters
              ...lcrds.map((kard) {
                bool isSelected = _selectedKardFilter == kard.id;
                return Padding(
                  padding: const EdgeInsets.only(right: 8.0),
                  child: Material(
                    elevation: isSelected ? 0 : 1,
                    shadowColor: Colors.black12,
                    borderRadius: BorderRadius.circular(30),
                    child: InkWell(
                      onTap: () {
                        HapticFeedback.selectionClick();
                        setState(() {
                          _selectedKardFilter = isSelected ? null : kard.id;
                        });
                      },
                      borderRadius: BorderRadius.circular(30),
                      child: Container(
                        padding: EdgeInsets.symmetric(horizontal: 16, vertical: 8),
                        decoration: BoxDecoration(
                          color: isSelected ? primaryColor.withOpacity(0.1) : Colors.white,
                          borderRadius: BorderRadius.circular(30),
                          border: Border.all(
                            color: isSelected ? primaryColor.withOpacity(0.3) : Colors.grey.shade100,
                            width: 1,
                          ),
                        ),
                        child: Row(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            Icon(
                              Icons.credit_card,
                              size: 18,
                              color: isSelected ? primaryColor : Colors.grey.shade400,
                            ),
                            SizedBox(width: 6),
                            Text(
                              kard.type,
                              style: TextStyle(
                                fontSize: 14,
                                fontWeight: isSelected ? FontWeight.w600 : FontWeight.w500,
                                color: isSelected ? primaryColor : Colors.black54,
                              ),
                            ),
                          ],
                        ),
                      ),
                    ),
                  ),
                );
              }).toList(),
            ],
          ),
        ),
      ],
    );
  }

  // Build attendee card
  Widget _buildAttendeeCard(Attendee attendee) {
    var fullname = attendee.fullName;
    var lcardname = attendee.cardName;
    String attendanceStatus = attendee.attendanceStatus ?? "Pending";

    // Set colors based on status
    Color statusColor;
    Color statusBgColor;
    IconData statusIcon;
    
    if (attendanceStatus == "Confirmed") {
      statusColor = Colors.green.shade700;
      statusBgColor = Colors.green.shade50;
      statusIcon = Icons.check_circle;
    } else if (attendanceStatus == "Declined") {
      statusColor = Colors.red.shade700;
      statusBgColor = Colors.red.shade50;
      statusIcon = Icons.cancel;
    } else { // Pending
      statusColor = Colors.amber.shade700;
      statusBgColor = Colors.amber.shade50;
      statusIcon = Icons.schedule;
    }

    var hasKey = selectList.any((test) => test.id == attendee.id);

    // Calculate message count if messages property exists
    int messageCount = (attendee.messages).length;

    return GestureDetector(
      onTap: () {
        HapticFeedback.mediumImpact();
        var found = selectList.firstWhereOrNull((test) => test.id == attendee.id);
        if (found != null) {
          setState(() {
            selectList.remove(found);
          });
        } else {
          Navigator.of(context).push(
            MaterialPageRoute(
              builder: (context) => ViewCard(
                cardUrl: attendee.cardUrl,
              ),
            ),
          );
        }
      },
      child: Container(
        margin: const EdgeInsets.symmetric(
          horizontal: 16,
          vertical: 6,
        ),
        decoration: BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.circular(16),
          boxShadow: [
            BoxShadow(
              color: Colors.black.withOpacity(0.04),
              offset: const Offset(0, 2),
              blurRadius: 8,
              spreadRadius: 0,
            ),
          ],
        ),
        child: Column(
          children: [
            Padding(
              padding: const EdgeInsets.all(16),
              child: Row(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  // Avatar with selection indicator
                  Stack(
                    clipBehavior: Clip.none,
                    children: [
                      Container(
                        width: 50,
                        height: 50,
                        decoration: BoxDecoration(
                          shape: BoxShape.circle,
                          gradient: hasKey
                              ? LinearGradient(
                                  colors: [
                                    primaryColor,
                                    primaryColor.withOpacity(0.8),
                                  ],
                                  begin: Alignment.topLeft,
                                  end: Alignment.bottomRight,
                                )
                              : null,
                          color: hasKey ? null : Colors.grey.shade100,
                          boxShadow: hasKey
                              ? [
                                  BoxShadow(
                                    color: primaryColor.withOpacity(0.3),
                                    blurRadius: 8,
                                    spreadRadius: 0,
                                    offset: Offset(0, 2),
                                  ),
                                ]
                              : null,
                        ),
                        child: Center(
                          child: Icon(
                            hasKey ? Icons.check : Icons.person,
                            color: hasKey ? Colors.white : Colors.grey.shade400,
                            size: 26,
                          ),
                        ),
                      ),
                      // Message counter badge
                      if (messageCount > 0)
                        Positioned(
                          right: -5,
                          top: -5,
                          child: Container(
                            padding: const EdgeInsets.all(6),
                            decoration: BoxDecoration(
                              color: Colors.red,
                              shape: BoxShape.circle,
                              boxShadow: [
                                BoxShadow(
                                  color: Colors.black.withOpacity(0.2),
                                  blurRadius: 4,
                                  offset: Offset(0, 2),
                                ),
                              ],
                            ),
                            child: Text(
                              "$messageCount",
                              style: const TextStyle(
                                color: Colors.white,
                                fontSize: 10,
                                fontWeight: FontWeight.bold,
                              ),
                            ),
                          ),
                        ),
                    ],
                  ),
                  
                  const SizedBox(width: 16),
                  
                  // Attendee details
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        // Name
                        Text(
                          fullname,
                          style: TextStyle(
                            fontWeight: FontWeight.w600,
                            fontSize: 16,
                            color: hasKey ? primaryColor : Colors.black87,
                            letterSpacing: -0.3,
                          ),
                        ),
                        SizedBox(height: 6),
                        
                        // Phone number with tap-to-call
                        GestureDetector(
                          onTap: () => _callAttendee(attendee.phone),
                          child: Row(
                            children: [
                              Icon(
                                Icons.phone,
                                size: 14,
                                color: Colors.blue.shade700,
                              ),
                              SizedBox(width: 6),
                              Text(
                                attendee.phone,
                                style: TextStyle(
                                  fontSize: 14,
                                  color: Colors.blue.shade700,
                                  fontWeight: FontWeight.w500,
                                ),
                              ),
                            ],
                          ),
                        ),
                        
                        SizedBox(height: 6),
                        
                        // Card name if available
                        if (lcardname.isNotEmpty)
                          Row(
                            children: [
                              Icon(
                                Icons.credit_card,
                                size: 14,
                                color: Colors.grey.shade600,
                              ),
                              SizedBox(width: 6),
                              Text(
                                lcardname,
                                style: TextStyle(
                                  fontSize: 14,
                                  color: Colors.grey.shade700,
                                ),
                              ),
                            ],
                          ),
                          
                        SizedBox(height: 10),
                        
                        // Status pill
                        Container(
                          padding: EdgeInsets.symmetric(horizontal: 10, vertical: 5),
                          decoration: BoxDecoration(
                            color: statusBgColor,
                            borderRadius: BorderRadius.circular(12),
                          ),
                          child: Row(
                            mainAxisSize: MainAxisSize.min,
                            children: [
                              Icon(
                                statusIcon,
                                size: 14,
                                color: statusColor,
                              ),
                              SizedBox(width: 6),
                              Text(
                                attendanceStatus,
                                style: TextStyle(
                                  fontSize: 13,
                                  fontWeight: FontWeight.w600,
                                  color: statusColor,
                                ),
                              ),
                            ],
                        ),
                      ),
                    ],
                  ),
                ),
                
                // Actions
                Column(
                  children: [
                    // Call button
                    Container(
                      width: 40,
                      height: 40,
                      margin: EdgeInsets.only(bottom: 8),
                      decoration: BoxDecoration(
                        color: Colors.blue.shade50,
                        borderRadius: BorderRadius.circular(12),
                      ),
                      child: IconButton(
                        icon: Icon(Icons.phone),
                        color: Colors.blue.shade700,
                        iconSize: 20,
                        padding: EdgeInsets.zero,
                        onPressed: () {
                          HapticFeedback.mediumImpact();
                          _callAttendee(attendee.phone);
                        },
                      ),
                    ),
                    
                    // Selection checkbox
                    if (selectList.isNotEmpty)
                      Container(
                        width: 40,
                        height: 40,
                        decoration: BoxDecoration(
                          color: hasKey ? primaryColor.withOpacity(0.1) : Colors.grey.shade100,
                          borderRadius: BorderRadius.circular(12),
                          border: Border.all(
                            color: hasKey ? primaryColor.withOpacity(0.3) : Colors.grey.shade300,
                            width: 1,
                          ),
                        ),
                        child: Checkbox(
                          value: hasKey,
                          onChanged: (value) {
                            HapticFeedback.selectionClick();
                            if (value == true) {
                              setState(() {
                                selectList.add(attendee);
                              });
                            } else {
                              var found = selectList.firstWhereOrNull((test) {
                                return test.id == attendee.id;
                              });
                              if (found != null) {
                                setState(() {
                                  selectList.remove(found);
                                });
                              }
                            }
                          },
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(4),
                          ),
                          activeColor: primaryColor,
                          checkColor: Colors.white,
                          materialTapTargetSize: MaterialTapTargetSize.shrinkWrap,
                        ),
                      ),
                  ],
                ),
              ],
            ),
            const Divider(height: 1),
            _buildAttendanceControls(attendee),
          ],
        ),
      ),
    );
  }

  Widget _buildAttendanceControls(Attendee attendee) {
    return ClipRRect(
      borderRadius: const BorderRadius.only(
        bottomLeft: Radius.circular(16),
        bottomRight: Radius.circular(16),
      ),
      child: BackdropFilter(
        filter: ImageFilter.blur(sigmaX: 8, sigmaY: 8),
        child: Container(
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
          decoration: BoxDecoration(
            color: Colors.grey.shade50.withOpacity(0.9),
            borderRadius: const BorderRadius.only(
              bottomLeft: Radius.circular(16),
              bottomRight: Radius.circular(16),
            ),
            border: Border(
              top: BorderSide(
                color: Colors.grey.shade200,
                width: 1,
              ),
            ),
          ),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Text(
                "Attendance",
                style: TextStyle(
                  fontWeight: FontWeight.w600,
                  fontSize: 14,
                  color: Colors.black87,
                  letterSpacing: -0.3,
                ),
              ),
              Row(
                children: [
                  _buildStatusButton(
                    attendee,
                    "Confirmed",
                    Icons.check_circle,
                    Colors.green,
                    attendee.attendanceStatus == "Confirmed",
                  ),
                  const SizedBox(width: 8),
                  _buildStatusButton(
                    attendee,
                    "Pending",
                    Icons.schedule,
                    Colors.amber,
                    attendee.attendanceStatus == "Pending" ||
                        attendee.attendanceStatus == null,
                  ),
                  const SizedBox(width: 8),
                  _buildStatusButton(
                    attendee,
                    "Declined",
                    Icons.cancel,
                    Colors.red,
                    attendee.attendanceStatus == "Declined",
                  ),
                ],
              ),
            ],
          ),
        ),
      ),
    );
  }
      color: Colors.transparent,
      child: InkWell(
        onTap: () {
          // Vibrate for haptic feedback
          HapticFeedback.mediumImpact();
          _updateAttendanceStatus(attendee, status);
        },
        borderRadius: BorderRadius.circular(30),
        child: Container(
          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
          decoration: BoxDecoration(
            color: isActive ? color.withOpacity(0.1) : Colors.transparent,
            borderRadius: BorderRadius.circular(30),
            border: isActive
                ? Border.all(color: color.withOpacity(0.5), width: 1)
                : null,
          ),
          child: Row(
            mainAxisSize: MainAxisSize.min,
            children: [
              Icon(
                icon,
                size: 16,
                color: color,
              ),
              if (isActive) const SizedBox(width: 6),
              if (isActive)
                Text(
                  status,
                  style: TextStyle(
                    fontSize: 13,
                    fontWeight: FontWeight.w600,
                    color: color,
                  ),
                ),
            ],
          ),
        ),
      ),
    );
  }

  selectAll() {
    if (atList.isNotEmpty) {
      if (selectList.length != atList.length) {
        selectList.addAll(atList);
      } else {
        selectList = [];
      }
      setState(() {});
    }
  }

  showCards() {
    return showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          content: SingleChildScrollView(
            child: CupertinoListSection.insetGrouped(
              header: const Text("Select Primary Card"),
              margin: EdgeInsets.zero,
              children: List.generate(lcrds.length, (index) {
                return GestureDetector(
                  onTap: () async {
                    poper();
                    await navNormal(
                      context: context,
                      widget: CreateAttendees(card: lcrds[index]),
                    );
                    await _loadAttendees();
                  },
                  child: ListTile(
                    title: Text(
                      lcrds[index].type,
                      style: const TextStyle(
                        fontSize: fsm,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    trailing: const Icon(size: icnmd, Icons.arrow_forward_ios),
                  ),
                );
              }),
            ),
          ),
        );
      },
    );
  }

  getCards() async {
    try {
      var res =
          await firestore
              .collection(ecol)
              .doc(widget.edata.id)
              .collection(cardcol)
              .get();
      lcrds =
          res.docs.map<Kard>((doc) {
            return Kard.fromMap(doc.id, doc.data());
          }).toList();
    } catch (e) {
      debugPrint("shida: $e");
    }
  }

  downCards() async {
    if (selectList.isEmpty) {
      showToast(isGood: false, msg: "No attendee(s) selected");
      return;
    }
    List<Attendee> lList = selectList;
    await StorageService.fetchFile(
      atList: lList,
      fdbck: (p0) {
        showToast(isGood: true, msg: p0);
      },
    );
  }

  delSelect() async {
    if (selectList.isEmpty) {
      showToast(isGood: false, msg: "Select attendee(s) first");
      return;
    }
    return await showCupertinoModalPopup(
      context: context,
      builder: (context) {
        return CupertinoActionSheet(
          title: const Text("Destructive Action"),
          message: Text(
            "You are about to delete ${selectList.length} attendee(s), keep in mind this action is ireversible",
            textAlign: TextAlign.center,
            style: const TextStyle(fontSize: fsm),
          ),
          actions: [
            CupertinoActionSheetAction(
              isDefaultAction: true,
              child: const Text("Delete", style: TextStyle(color: Colors.red)),
              onPressed: () async {
                await del();
                await _loadAttendees();
              },
            ),
            CupertinoActionSheetAction(
              child: const Text("Cancel"),
              onPressed: () {
                poper();
              },
            ),
          ],
        );
      },
    );
  }

  del() async {
    try {
      poper();
      showToast(isGood: true, msg: "Deleting....");
      for (var sel in selectList) {
        var cRef = storage.refFromURL(sel.cardUrl);
        await cRef.delete();
        await firestore
            .collection(ecol)
            .doc(widget.edata.id)
            .collection(atcol)
            .doc(sel.id)
            .delete();
      }
      selectList = [];
      showToast(isGood: true, msg: "Success");
    } catch (e) {
      showToast(isGood: false, msg: "$e");
    }
  }

  importNow() async {
    FilePickerResult? result = await FilePicker.platform.pickFiles(
      type: FileType.custom,
      allowedExtensions: ['xls', 'xlsx', 'xlsm', 'xlsb'],
    );
    if (result != null) {
      file = File(result.files.single.path!);
      var bytes = file?.readAsBytesSync();
      var excel = exl.Excel.decodeBytes(bytes!);
      var tblKey = excel.tables.keys.firstOrNull;
      var table = excel.tables[tblKey];

      var frow = table!.rows.first;
      Map<dynamic, dynamic> sels = {};
      for (var cell in frow) {
        sels[cell!.columnIndex] = cell.value;
      }
      await showMatcher(sels);
    } else {
      showToast(isGood: false, msg: genErrMsg);
    }
  }

  showMatcher(Map<dynamic, dynamic> sels) {
    if (lcrds.isEmpty) {
      showToast(isGood: false, msg: "This action requires existing cards");
      return;
    }
    // creating a synthetic map for cards
    var synCrdmap = {};
    for (var lcrd in lcrds) {
      synCrdmap[lcrd.id] = lcrd.type;
    }
    // ends here
    return showModalBottomSheet(
      showDragHandle: true,
      context: context,
      builder: (context) {
        return SingleChildScrollView(
          child: CupertinoListSection.insetGrouped(
            margin: const EdgeInsets.only(
              left: psm * 0.5,
              right: psm * 0.5,
              bottom: psm * 1.5,
            ),
            header: const Text("Map Excel Data"),
            children: [
              Padding(
                padding: const EdgeInsets.all(psm),
                child: Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    const Text(
                      "Name",
                      style: TextStyle(
                        fontSize: fsm + 2,
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                    buildDrop(sels, mpname),
                  ],
                ),
              ),
              Padding(
                padding: const EdgeInsets.all(psm),
                child: Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    const Text(
                      "Phone",
                      style: TextStyle(
                        fontSize: fsm + 2,
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                    buildDrop(sels, mpphone),
                  ],
                ),
              ),
              Padding(
                padding: const EdgeInsets.all(psm),
                child: Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    const Text(
                      "Card",
                      style: TextStyle(
                        fontSize: fsm + 2,
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                    buildDrop(synCrdmap, mpcard),
                  ],
                ),
              ),
              SizedBox(
                width: double.maxFinite,
                child: MaterialButton(
                  color: primaryColor,
                  shape: const RoundedRectangleBorder(
                    borderRadius: BorderRadius.only(
                      bottomLeft: Radius.circular(bsm),
                      bottomRight: Radius.circular(bsm),
                    ),
                  ),
                  height: kToolbarHeight * 0.75,
                  child: const Text(
                    "Continue",
                    style: TextStyle(
                      fontSize: fsm,
                      color: Colors.white,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  onPressed: () async {
                    if (isGreen()) {
                      poper();
                      Map<String, dynamic> mapp = {
                        'fullName': int.parse(mpname.text),
                        'phone': int.parse(mpphone.text),
                      };
                      var carddata = lcrds.firstWhere((lcrd) {
                        return lcrd.id == mpcard.text;
                      });
                      await Navigator.of(context).push(
                        MaterialPageRoute(
                          builder: (context) {
                            return ImpPreview(
                              mapp: mapp,
                              xcelFile: file!,
                              carddata: carddata,
                              eId: widget.edata.id,
                            );
                          },
                        ),
                      );
                      await _loadAttendees();
                    }
                  },
                ),
              ),
            ],
          ),
        );
      },
    );
  }

  buildDrop(Map sels, TextEditingController mapcont) {
    return DropdownMenu(
      hintText: "Select values",
      width: MediaQuery.of(context).size.width * 0.4,
      inputDecorationTheme: const InputDecorationTheme(),
      onSelected: (value) {
        mapcont.text = "$value";
      },
      dropdownMenuEntries:
          sels.entries.map((entry) {
            return DropdownMenuEntry(value: entry.key, label: "${entry.value}");
          }).toList(),
    );
  }

  isGreen() {
    if (mpname.text.isEmpty) {
      showToast(isGood: false, msg: "Select a column with values for name");
      return false;
    } else if (mpphone.text.isEmpty) {
      showToast(isGood: false, msg: "Select a column with values for phone");
      return false;
    } else if (mpcard.text.isEmpty) {
      showToast(isGood: false, msg: "Select a card to assign the attendees");
      return false;
    } else {
      return true;
    }
  }

  poper() {
    Navigator.of(context).pop();
  }
}
