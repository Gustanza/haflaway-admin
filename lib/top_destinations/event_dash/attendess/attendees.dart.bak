  // Build attendance stats widget
  Widget _buildAttendanceStats() {
    // Count attendees by status
    String confirmed = "Confirmed";
    String pending = "Pending";
    String declined = "Declined";

    return Row(
      children: [
        _buildStatIndicator(true, confirmed, Colors.green),
        const SizedBox(width: 8),
        _buildStatIndicator(
          false,
          pending,
          const Color.fromARGB(255, 196, 153, 21),
        ),
        const SizedBox(width: 8),
        _buildStatIndicator(true, declined, Colors.red),
      ],
    );
  }

  // Build stat indicator
  Widget _buildStatIndicator(bool postv, String fltr, Color color) {
    var pathy =
        postv
            ? firestore
                .collection(ecol)
                .doc(widget.edata.id)
                .collection(atcol)
                .where("attendanceStatus", isEqualTo: fltr)
            : firestore
                .collection(ecol)
                .doc(widget.edata.id)
                .collection(atcol)
                .where(
                  Filter.or(
                    Filter('attendanceStatus', isNull: true),
                    Filter('attendanceStatus', isEqualTo: 'Pending'),
                  ),
                );
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: psm, vertical: 4),
      decoration: BoxDecoration(
        color: color,
        borderRadius: BorderRadius.circular(88),
      ),
      child: FutureBuilder(
        future: pathy.count().get(),
        builder: (context, snapshot) {
          if (snapshot.hasError) {
            return Text("🥵");
          } else if (snapshot.hasData) {
            return Text(
              "${snapshot.data?.count}",
              style: TextStyle(
                color: Colors.white,
                fontWeight: FontWeight.bold,
              ),
            );
          } else {
            return CupertinoActivityIndicator(color: Colors.white);
          }
        },
      ),
    );
  }

  // Build status filter chips
  Widget _buildStatusFilterChips() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        // Section title
        Padding(
          padding: const EdgeInsets.only(left: 16, bottom: 8),
          child: Text(
            "Status",
            style: TextStyle(
              fontSize: 16,
              fontWeight: FontWeight.w600,
              color: Colors.black87,
              letterSpacing: -0.3,
            ),
          ),
        ),
        // Chips container
        Container(
          height: 50,
          padding: const EdgeInsets.symmetric(horizontal: 16),
          child: ListView(
            scrollDirection: Axis.horizontal,
            children: _filters.map((filter) {
              bool isSelected = _currentFilter == filter;
              // Determine color scheme based on filter type
              Color chipColor;
              Color textColor;
              Color iconColor;
              
              if (filter == "Confirmed") {
                chipColor = isSelected ? Colors.green.shade50 : Colors.white;
                textColor = isSelected ? Colors.green.shade700 : Colors.black54;
                iconColor = isSelected ? Colors.green : Colors.green.shade300;
              } else if (filter == "Declined") {
                chipColor = isSelected ? Colors.red.shade50 : Colors.white;
                textColor = isSelected ? Colors.red.shade700 : Colors.black54;
                iconColor = isSelected ? Colors.red : Colors.red.shade300;
              } else if (filter == "Pending") {
                chipColor = isSelected ? Colors.amber.shade50 : Colors.white;
                textColor = isSelected ? Colors.amber.shade700 : Colors.black54;
                iconColor = isSelected ? Colors.amber : Colors.amber.shade300;
              } else { // All
                chipColor = isSelected ? primaryColor.withOpacity(0.1) : Colors.white;
                textColor = isSelected ? primaryColor : Colors.black54;
                iconColor = isSelected ? primaryColor : Colors.grey.shade400;
              }
              
              return Padding(
                padding: const EdgeInsets.only(right: 8.0),
                child: Material(
                  elevation: isSelected ? 0 : 1,
                  shadowColor: Colors.black12,
                  borderRadius: BorderRadius.circular(30),
                  child: InkWell(
                    onTap: () {
                      HapticFeedback.selectionClick();
                      setState(() {
                        _currentFilter = filter;
                      });
                    },
                    borderRadius: BorderRadius.circular(30),
                    child: Container(
                      padding: EdgeInsets.symmetric(horizontal: 16, vertical: 8),
                      decoration: BoxDecoration(
                        color: chipColor,
                        borderRadius: BorderRadius.circular(30),
                        border: Border.all(
                          color: isSelected ? 
                            (filter == "Confirmed" ? Colors.green.shade200 : 
                             filter == "Declined" ? Colors.red.shade200 : 
                             filter == "Pending" ? Colors.amber.shade200 : 
                             primaryColor.withOpacity(0.3)) : 
                            Colors.grey.shade100,
                          width: 1,
                        ),
                      ),
                      child: Row(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          Icon(
                            filter == "All" ? Icons.people :
                            filter == "Confirmed" ? Icons.check_circle :
                            filter == "Pending" ? Icons.schedule :
                            Icons.cancel,
                            size: 18,
                            color: iconColor,
                          ),
                          SizedBox(width: 6),
                          Text(
                            filter,
                            style: TextStyle(
                              fontSize: 14,
                              fontWeight: isSelected ? FontWeight.w600 : FontWeight.w500,
                              color: textColor,
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                ),
              );
            }).toList(),
          ),
        ),
      ],
    );
  }

